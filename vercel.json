{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tapiclean-new-website.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/curatare-canapele", "destination": "/servicii/curatare-canapele", "statusCode": 301 },
    { "source": "/curatare-canapele.html", "destination": "/servicii/curatare-canapele", "statusCode": 301 },
    { "source": "/curatare-auto", "destination": "/servicii/curatare-interior-auto", "statusCode": 301 },
    { "source": "/curatare-auto.html", "destination": "/servicii/curatare-interior-auto", "statusCode": 301 },
    { "source": "/servicii/uscarea-tapiteriei.html", "destination": "/servicii/uscarea-tapiteriei", "statusCode": 301 }
    { "source": "/uscarea-tapiteriei", "destination": "/servicii/uscarea-tapiteriei", "statusCode": 301 }
  ]
}